    "students = {}\n",
    "\n",
    "def add_student():\n",
    "    roll = input(\"Enter Roll Number: \")\n",
    "    name = input(\"Enter Student Name: \")\n",
    "    marks = int(input(\"Enter Marks: \"))\n",
    "\n",
    "    students[roll] = {\n",
    "        \"Name\": name,\n",
    "        \"Marks\": marks\n",
    "    }\n",
    "\n",
    "    print(\"Student Added Successfully!\")\n",
    "\n",
    "def display_students():\n",
    "    print(\"\\nStudent Details:\")\n",
    "    for roll, details in students.items():\n",
    "        print(roll, details)\n",
    "\n",
    "add_student()\n",
    "display_students()"
   ]
